# Bluegrass Gameday — Admin Portal PRODUCTION build variables
#
# A real .env.production (copied from this file, with the actual Firebase web
# config from the Firebase console) is REQUIRED before `npm run build` for
# deploy. Without it the bundle falls back to placeholder config and cannot
# reach the real project. The web config values below are public identifiers,
# not secrets — but App Check (reCAPTCHA Enterprise) must be wired into
# src/lib/firebase.ts as part of the first real deploy (see
# docs/13_TESTING_DEPLOYMENT.md).
#
# Leave VITE_USE_EMULATOR unset (or 'false') — production must never point at
# localhost emulators.

VITE_USE_EMULATOR=false

VITE_FIREBASE_API_KEY=REPLACE_WITH_REAL_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=REPLACE_WITH_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=REPLACE_WITH_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=REPLACE_WITH_PROJECT.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=REPLACE_WITH_SENDER_ID
VITE_FIREBASE_APP_ID=REPLACE_WITH_APP_ID

# Bluegrass Gameday — Admin Portal Environment Variables
# Copy this file to .env.development for local dev (emulator mode)
# Never commit real API keys or .env files with secrets.

# Emulators are OPT-IN: the app only connects to localhost emulators when this
# is exactly 'true'. Unset (or any other value) targets the real Firebase
# project — the safe default for production builds.
VITE_USE_EMULATOR=true

# Firebase project config — use harmless demo values for emulator; replace for real project
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=bluegrass-gameday-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=bluegrass-gameday-dev
VITE_FIREBASE_STORAGE_BUCKET=bluegrass-gameday-dev.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

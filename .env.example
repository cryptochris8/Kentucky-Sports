# Copy to .env.local for emulator use. NEVER commit real secrets, and NEVER put any of
# these into the Flutter app or the admin frontend — they are server-side (Functions) only.

# External sports data providers (Phase 2+)
CFBD_API_KEY=
CBBD_API_KEY=

# Optional AI summaries (Phase 5)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Payments (later)
STRIPE_SECRET=
REVENUECAT_WEBHOOK_SECRET=

# Local emulator
FIRESTORE_EMULATOR_HOST=localhost:8080
GCLOUD_PROJECT=bluegrass-gameday-dev

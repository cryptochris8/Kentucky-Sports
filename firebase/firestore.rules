rules_version = '2';

// Bluegrass Gameday — Firestore security rules (Phase 0/1 draft)
//
// Model (see docs/04_FIREBASE_DATA_MODEL.md and docs/11_SECURITY_LEGAL_COMPLIANCE.md):
//  - Public read for published reference data (teams, games, stats, news, polls, badges...).
//  - Authenticated users manage ONLY their own profile, reactions, posts.
//  - Prediction entries are written ONLY through the submitPrediction callable, which
//    validates status/closesAt/options server-side; scoring is Functions-only.
//  - Stat imports & scored results are written ONLY by the Functions service account,
//    which bypasses these rules. Clients are therefore denied writes to those collections.
//  - Roles come from custom claims (request.auth.token.role); admin/editor manage CMS,
//    moderators manage post visibility.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }
    function role() {
      return isSignedIn() && request.auth.token.role != null
        ? request.auth.token.role
        : 'guest';
    }
    function isAdmin()     { return role() == 'admin'; }
    function isEditor()    { return role() == 'editor' || isAdmin(); }
    function isModerator() { return role() == 'moderator' || isAdmin(); }
    function isOwner(uid)  { return isSignedIn() && request.auth.uid == uid; }

    // True when an update leaves `field` untouched (absent on both sides counts
    // as unchanged). Used to pin server-owned fields on client updates.
    function unchangedField(field) {
      return (field in request.resource.data) == (field in resource.data)
        && (!(field in resource.data) || request.resource.data[field] == resource.data[field]);
    }

    // Public, read-only reference collections (server/admin-written only).
    // NOTE: `articles` has its own status-gated block below.
    function isPublicReference(col) {
      return col in [
        'teams', 'seasons', 'games', 'game_summaries', 'team_stats',
        'player_profiles', 'player_stats', 'badges', 'news_cards',
        'high_schools', 'high_school_games', 'recruits', 'app_config', 'venues'
      ];
    }

    // ---------- users ----------
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || isModerator();
      // A user creates/updates only their own profile and may not self-assign privileged
      // fields (role / xp / level / predictionRecord are managed by Cloud Functions).
      // On create the progression fields must start at their zero state (or be absent).
      allow create: if isOwner(userId)
                    && (!('role' in request.resource.data) || request.resource.data.role == 'user')
                    && (!('xp' in request.resource.data) || request.resource.data.xp == 0)
                    && (!('level' in request.resource.data) || request.resource.data.level == 1)
                    && !('predictionRecord' in request.resource.data);
      allow update: if isOwner(userId)
                    && unchangedField('role')
                    && unchangedField('xp')
                    && unchangedField('level')
                    && unchangedField('predictionRecord');
      allow update, delete: if isAdmin();

      // A user's earned badges are server-awarded; readable by the owner/admin.
      match /user_badges/{badgeId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false; // Cloud Functions only
      }
    }

    // ---------- public reference data ----------
    match /{col}/{docId} {
      allow read: if isPublicReference(col);
      // CMS content (games, news, etc.) editable by editors/admins from the portal.
      allow create, update, delete: if isEditor()
        && col in ['teams','seasons','games','game_summaries','news_cards',
                   'high_schools','high_school_games','recruits','app_config'];
      // Stat & summary imports are Functions-only.
      allow write: if false
        && col in ['team_stats','player_stats','player_profiles'];
    }

    // ---------- articles (AI-drafted game coverage) ----------
    // Public may read ONLY published articles — flipping status to draft/hidden
    // actually removes them from clients. Editors see and manage everything
    // (mirrors the vault_legends gate below).
    match /articles/{articleId} {
      allow read: if resource.data.status == 'published' || isEditor();
      allow create, update, delete: if isEditor();
    }

    // ---------- predictions (questions) ----------
    match /predictions/{predictionId} {
      allow read: if true;
      allow create, update, delete: if isEditor();
    }

    // ---------- prediction entries (user picks) ----------
    // All writes go through the submitPrediction callable, which enforces
    // open-status / closesAt / valid-option / one-pick-per-user server-side.
    // Direct client writes would bypass the kickoff lock, so they are denied.
    match /prediction_entries/{entryId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create, update, delete: if false; // submitPrediction + scoring Functions only
    }

    // ---------- polls ----------
    match /polls/{pollId} {
      allow read: if true;
      allow create, update, delete: if isEditor();
      // Votes are written through the votePoll Cloud Function (atomic counters).
    }

    // ---------- community posts ----------
    match /community_posts/{postId} {
      allow read: if resource.data.status == 'visible' || isModerator()
                  || isOwner(resource.data.userId);
      allow create: if isSignedIn()
                    && isOwner(request.resource.data.userId)
                    && request.resource.data.status == 'pending';
      // Author may edit body while pending/visible; moderators control status.
      // Server-owned fields are pinned for everyone: authorship cannot be
      // reassigned and reaction counters belong to the reactToPost callable.
      allow update: if ((isOwner(resource.data.userId)
                          && request.resource.data.status == resource.data.status)
                        || isModerator())
                    && unchangedField('userId')
                    && unchangedField('reactionCounts')
                    && unchangedField('createdAt');
      allow delete: if isModerator() || isOwner(resource.data.userId);

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && isOwner(request.resource.data.userId);
        allow update, delete: if isOwner(resource.data.userId) || isModerator();
      }
    }

    // ---------- The Vault ----------
    // Factual season records — public read, editor-managed writes.
    match /vault_seasons/{id} {
      allow read: if true;
      allow create, update, delete: if isEditor();
    }
    // AI-drafted history features — public can read ONLY once published;
    // editors see drafts/ready and manage all writes from the Vault editor.
    match /vault_legends/{id} {
      allow read: if resource.data.status == 'published' || isEditor();
      allow create, update, delete: if isEditor();
    }
    // Sourced fact-sheet briefs — editor-only (grounds the fact-check guard).
    match /legend_briefs/{id} {
      allow read, write: if isEditor();
    }

    // ---------- moderation / sync logs (admin + functions) ----------
    match /sync_runs/{runId} {
      allow read: if isAdmin();
      allow write: if false; // Cloud Functions only
    }
    // Append-only audit trail. Moderators write records of their own actions
    // from the portal; nobody can rewrite or delete history from a client.
    match /moderation_actions/{actionId} {
      allow read: if isModerator();
      allow create: if isModerator()
                    && request.resource.data.postId is string
                    && request.resource.data.action is string
                    && request.resource.data.moderatorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ---------- watch parties / check-ins (Phase 4 placeholders) ----------
    match /watch_parties/{partyId} {
      allow read: if true;
      allow write: if isEditor();
    }
    match /check_ins/{checkInId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if false;
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
